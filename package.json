{
  "name": "momentread",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.0 <23"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "start": "node dist/server/index.js",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:live": "tsx scripts/claude-probe.ts --live",
    "contracts": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@phosphor-icons/react": "2.1.10",
    "better-sqlite3": "13.0.3",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "hono": "4.13.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sanitize-html": "2.17.7",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "5.0.4",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "6.4.3",
    "vitest": "5.0.0"
  }
}
